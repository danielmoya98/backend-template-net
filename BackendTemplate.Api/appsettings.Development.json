{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=BackendTemplateDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForDevelopmentAndTemplatePurposesMustBeAtLeast32BytesLong!",
    "Issuer": "BackendTemplateApi",
    "Audience": "BackendTemplateClients",
    "ExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "StoragePath": "wwwroot/uploads"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  }
}